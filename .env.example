# ---------------------------------------------------------------------------
# Arrangement Analyzer — environment configuration
# Copy to `.env` and fill in.  NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# DeepSeek API key.  Get one at https://platform.deepseek.com
# Required for the producer-level reasoning layer. The app degrades
# gracefully (DSP-only mode, no commentary) if this is missing.
DEEPSEEK_API_KEY=

# DeepSeek base URL. Change this if you use a gateway/proxy.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model ids. Both are DeepSeek-V4.1-series, 1M ctx.
#   deepseek-flash  = DeepSeek-V4.1-Flash   (fast, text+image)  <- default
#   deepseek-v4-pro = DeepSeek-V4-Pro       (slow, deeper, text only)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_DEEP=deepseek-v4-pro

# reasoning effort for the heavy model: low | high | max
DEEPSEEK_EFFORT=high

# ---------------------------------------------------------------------------
# Device / compute
# ---------------------------------------------------------------------------
# auto | cpu | mps | cuda
ARRANGEMENT_DEVICE=auto

# Optional cap on torch threads (blank = let it decide).
ARRANGEMENT_TORCH_THREADS=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Where uploads, caches and analyses live.
ARRANGEMENT_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Analysis quality / cost
# ---------------------------------------------------------------------------
#   fast     — 22.05 kHz working audio, single separation pass. ~40 s/song.
#   standard — 44.1 kHz, 6-stem Demucs on MPS. ~1.5 min/song. (default)
#   deep     — adds the BS-RoFormer vocals pass. ~14 min/song. The vocals are
#              cleaner, but that model runs at ~0.2x realtime on Apple Silicon.
ARRANGEMENT_QUALITY=standard

# Separation preset (see backend/arrangement/models/separation.py::_plan).
# NOTE: the RoFormer passes only run at quality=deep, because they are slow.
#   multi               6-stem Demucs (default)
#   htdemucs            4 stems
#   htdemucs_ft         4 stems, bag of 4, best 4-stem quality, slow
#   htdemucs_6s         6 stems
#   roformer4           4-stem Mel-Band RoFormer (slower than Demucs)
#   roformer_vocals     2-stem BS-RoFormer (Vocals / Instrumental)
#   bs_roformer_vocals_plus   6-stem Demucs + BS-RoFormer vocals
ARRANGEMENT_SEPARATOR=multi

# Download HF models on first run? (set 0 for fully offline after priming)
ARRANGEMENT_ALLOW_DOWNLOAD=1
